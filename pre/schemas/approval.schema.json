{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovalDecision v1 (pre-production)",
  "type": "object",
  "required": ["schemaVersion", "approvalId", "jobId", "brand", "gate", "round", "decision", "artifacts", "decidedBy", "decidedAt", "channel"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "approvalId": { "type": "string" },
    "jobId": { "type": "string" },
    "brand": { "type": "string" },
    "client": { "type": "string" },
    "gate": { "enum": ["A", "B", "C", "sample"] },
    "round": { "type": "integer", "minimum": 1 },
    "decision": { "enum": ["approved", "changes_requested", "rejected"] },
    "edited": { "type": "boolean" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["path", "sha256", "bytes"], "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer" } } } },
    "decidedBy": { "type": "string", "minLength": 1 },
    "decidedAt": { "type": "string" },
    "channel": { "enum": ["board", "chat", "file"] },
    "comment": { "type": "string" },
    "boardRecord": { "type": "object" },
    "day": { "type": ["integer", "null"], "minimum": 1 },
    "scope": { "type": "object", "properties": {
      "maxSpendCredits": { "type": ["number", "null"], "minimum": 0 },
      "panelsOnDisk": { "type": "integer", "minimum": 0 },
      "boardVersion": { "type": ["integer", "null"] }
    } },
    "supersedes": { "type": ["string", "null"] }
  }
}
