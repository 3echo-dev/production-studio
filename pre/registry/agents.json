      "allowedSkillIds": ["client-skill-wrap", "storyboard"],
      "deniedSideEffects": ["external_write", "paid_spend", "credential_read"], "ownerForKinds": [], "maxTurns": 40 },
    { "agentId": "shot-list-director", "role": "shot-list-director", "discipline": "shot_list", "status": "active", "model": "sonnet",
