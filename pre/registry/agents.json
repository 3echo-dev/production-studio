      "deniedSideEffects": ["external_write", "paid_spend", "credential_read"], "ownerForKinds": [], "maxTurns": 30 },
    { "agentId": "breakdown-compiler", "role": "breakdown-compiler", "discipline": "breakdown", "status": "active", "model": "sonnet",
      "description": "Compiles the MOT-format concept breakdown into the client's template from every upstream record, column order preserved, and checks a sample against source.",
      "accepts": ["shot-list.csv", "storyboard/v{n}/panels.md", "audio.md", "registers/*.json", "client/templates/breakdown.xlsx"], "produces": ["breakdown.xlsx", "breakdown.md", "validation/breakdown-check.md"],
      "allowedSkillIds": [],
      "deniedSideEffects": ["external_write", "paid_spend", "credential_read"], "ownerForKinds": [], "maxTurns": 40 },
