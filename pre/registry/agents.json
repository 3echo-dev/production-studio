      "deniedSideEffects": [], "ownerForKinds": ["preproduction"], "maxTurns": null },
    { "agentId": "intake-director", "role": "intake-director", "discipline": "intake", "status": "active", "model": "sonnet",
      "description": "Indexes the pulled Drive folder and writes the unified brief with a conflict list and open questions.",
