      "accepts": ["brief.md", "shot-list.csv", "client/templates/*.xlsx", "registers/talents.json"], "produces": ["budget.xlsx", "timeline.xlsx", "budget.md", "timeline.md"],
      "allowedSkillIds": [],
      "deniedSideEffects": ["external_write", "paid_spend", "credential_read"], "ownerForKinds": [], "maxTurns": 30 },
    { "agentId": "audio-supervisor", "role": "audio-supervisor", "discipline": "audio", "status": "active", "model": "sonnet",
      "description": "Writes VO, BGM and SFX requirements per scene with a library source per row; voice and track choices are board questions.",
      "accepts": ["script/v{k}.md", "storyboard/v{n}/panels.md", "workspace.json"], "produces": ["audio.md"],
