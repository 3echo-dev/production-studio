      "description": "Builds one call sheet per shoot day in the HTF layout from the rows a person assigned, shooting order kept, overnight blocks computed, parallel units flagged.",
      "accepts": ["breakdown.xlsx", "registers/*.json", "timeline.xlsx", "client/templates/call-sheet.xlsx"], "produces": ["call-sheets/day-{d}.xlsx", "call-sheets/day-{d}.md", "validation/call-sheet-check.md"],
